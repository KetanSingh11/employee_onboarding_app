# ──────────────────────────────────────────────
# PostgreSQL container credentials
# ──────────────────────────────────────────────
POSTGRES_USER=onboarding_user
POSTGRES_PASSWORD=onboarding_pass
POSTGRES_DB=staffplanner

# ──────────────────────────────────────────────
# Application database URLs
# asyncpg driver required for SQLAlchemy async
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://onboarding_user:onboarding_pass@localhost:5432/staffplanner
TEST_DATABASE_URL=postgresql+asyncpg://onboarding_user:onboarding_pass@localhost:5432/staffplanner_test

# ──────────────────────────────────────────────
# API Keys → role mapping
# Use these values in the X-API-Key header
# ──────────────────────────────────────────────
API_KEY_ADMIN=admin-secret-key
API_KEY_HR=hr-secret-key
API_KEY_VIEWER=viewer-secret-key

# ──────────────────────────────────────────────
# Application settings
# ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# Idempotency key TTL in seconds (default: 86400 = 24h)
# ──────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400

